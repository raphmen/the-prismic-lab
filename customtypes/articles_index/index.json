{
  "id": "articles_index",
  "label": "Articles Index",
  "repeatable": false,
  "status": true,
  "format": "page",
  "json": {
    "Main": {
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "single": "heading1,heading2,heading3,heading4,heading5,heading6"
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "label": "Description",
          "multi": "paragraph,strong,em,hyperlink"
        }
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Featured Image"
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
