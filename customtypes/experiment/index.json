{
  "id": "experiment",
  "label": "Experiment",
  "repeatable": true,
  "status": true,
  "format": "page",
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "rich_text": {
              "type": "SharedSlice"
            },
            "media": {
              "type": "SharedSlice"
            },
            "code_snippet": {
              "type": "SharedSlice"
            },
            "callout": {
              "type": "SharedSlice"
            },
            "related": {
              "type": "SharedSlice"
            }
          }
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "single": "heading1,heading2,heading3,heading4,heading5,heading6"
        }
      },
      "excerpt": {
        "type": "Text",
        "config": {
          "label": "Excerpt"
        }
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Featured Image"
        }
      },
      "stack": {
        "type": "Group",
        "config": {
          "label": "Stack",
          "fields": {
            "tech": {
              "type": "Link",
              "config": {
                "label": "Tech",
                "select": "document",
                "customtypes": [
                  {
                    "id": "tech",
                    "fields": [
                      "name"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "categories": {
        "type": "Group",
        "config": {
          "label": "Categories",
          "fields": {
            "category": {
              "type": "Link",
              "config": {
                "label": "Category",
                "select": "document",
                "customtypes": [
                  {
                    "id": "category",
                    "fields": [
                      "name"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "authors": {
        "type": "Group",
        "config": {
          "label": "Authors",
          "fields": {
            "author": {
              "type": "Link",
              "config": {
                "label": "Author",
                "select": "document",
                "customtypes": [
                  {
                    "id": "author",
                    "fields": [
                      "name"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "published_date": {
        "type": "Date",
        "config": {
          "label": "Published Date"
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}